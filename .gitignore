# Nx wrapper install dir: ignore node_modules etc., but commit the lockfile so
# ./nx installs deterministically (nxw.js runs `npm i` here with no lock otherwise).
.nx/installation/*
!.nx/installation/package-lock.json
.nx/cache
.nx/workspace-data
.nx/self-healing
.nx/migrate-runs
.nx/polygraph
.claude/worktrees
.claude/settings.local.json
*.DS_Store
peopleportal/server/.env.development

# Bootstrap script outputs (contain credentials)
peopleportal/server/scripts/.oidc
peopleportal/server/scripts/.env
peopleportal/server/scripts/.gitea-app-token
peopleportal/server/scripts/.gitea-admin-pass
peopleportal/server/.env.development*
