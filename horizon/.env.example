# Copy these values into a local, untracked env file or export them in your shell.
PHI_GITEA_URL=https://git.appdevclub.com
PHI_GITEA_API_TOKEN=replace-with-a-read-capable-gitea-api-token

# People Portal's service-authenticated generated SDK API.
PHI_PEOPLE_PORTAL_URL=https://people-portal.example.org
PHI_PEOPLE_PORTAL_API_TOKEN=replace-with-the-strong-people-portal-service-token

# Optional local PostgreSQL settings for the export loader.
GITEA_ANALYTICS_DB=gitea_analytics
GITEA_ANALYTICS_USER=gitea_analytics
GITEA_ANALYTICS_PASSWORD=replace-with-a-local-database-password
GITEA_ANALYTICS_DATABASE_URL=postgresql://gitea_analytics:replace-with-a-local-database-password@127.0.0.1:5433/gitea_analytics

# Server mode: public local demo by default; set production before exposing data.
PHI_ENVIRONMENT=local
PHI_SQLITE_PATH=./data/project_health_intelligence.db
PHI_ARTIFACT_ROOT=./data/horizon
PHI_LLM_ENABLED=false
# Optional Gemini qualitative-analysis provider. Keep disabled unless the key
# is intentionally configured for this environment.
# PHI_GEMINI_API_KEY=replace-with-a-gemini-api-key
# PHI_GEMINI_MODEL=gemini-2.5-flash
# Production: supply distinct random secrets (minimum 24 characters per operator).
# PHI_API_TOKENS='{"reviewer-name":"replace-with-a-unique-random-secret"}'
# PHI_ADMIN_SYNC_TOKEN=replace-with-a-separate-random-ingestion-secret
# PHI_AGENT_INGEST_TOKEN=replace-with-a-separate-ci-secret
# PHI_API_BASE=http://127.0.0.1:8000
# Optional for an intentional cross-origin deployment (JSON array):
# PHI_CORS_ORIGINS='["https://horizon.example.org"]'
