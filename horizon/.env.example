# Copy these values into a local, untracked env file or export them in your shell.
# Set HORIZON_ENV_FILE="" to disable dotenv loading entirely (the test suite does).

# Gitea instance the pipeline reads from. Also accepted under their PHI_ names,
# so an existing local env file keeps working.
HORIZON_GITEA_URL=https://git.example.com
HORIZON_GITEA_API_TOKEN=

# Authentik directory used by People Portal for its onboarded member roster.
# The token needs read access to users on the configured Authentik instance.
HORIZON_AUTHENTIK_URL=https://auth.example.com
HORIZON_AUTHENTIK_API_TOKEN=

# Postgres feature store. Use the legacy Horizon deploy/Supabase connection URL
# here or export GITEA_ANALYTICS_DATABASE_URL in the deployment environment.
HORIZON_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
