{
  "name": "horizon",
  "projectType": "application",
  "sourceRoot": "horizon",
  "tags": [
    "scope:horizon"
  ],
  "targets": {
    "install-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m venv .venv && .venv/bin/python -m pip install -q -e '.[test]'",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m compileall -q backend",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "install-deps"
      ],
      "options": {
        "command": ".venv/bin/ruff check backend tests",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "install-deps"
      ],
      "options": {
        "command": "PHI_ENV_FILE='' PHI_ENVIRONMENT=test .venv/bin/python -m pytest -q",
        "cwd": "{projectRoot}"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        "test",
        "lint"
      ],
      "options": {
        "command": "true",
        "cwd": "{projectRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "install-deps"
      ],
      "options": {
        "command": "PHI_ENV_FILE='' PHI_ENVIRONMENT=local .venv/bin/python -m uvicorn backend.main:app --reload --port 8000",
        "cwd": "{projectRoot}"
      }
    },
    "docker:build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -f horizon/Dockerfile.monorepo -t horizon .",
        "cwd": "{workspaceRoot}"
      }
    },
    "docker:run": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "docker:build"
      ],
      "options": {
        "command": "docker run {args} horizon",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
