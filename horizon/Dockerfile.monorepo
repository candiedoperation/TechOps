FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PHI_ENV_FILE="" PHI_ENVIRONMENT=production PHI_SQLITE_PATH=/var/lib/horizon/horizon.db
WORKDIR /app
COPY horizon/pyproject.toml horizon/requirements.lock ./
COPY peopleportal/sdk/python/src /opt/peopleportal-sdk
COPY horizon/backend ./backend
COPY horizon/scripts ./scripts
COPY horizon/run_pipeline.py horizon/build_member_profiles.py horizon/load_postgres.py horizon/schema.sql ./
COPY horizon/fixtures ./fixtures
COPY horizon/index.html horizon/app.js horizon/styles.css ./
COPY horizon/assets ./assets
COPY horizon/analytics ./analytics
COPY horizon/profiles ./profiles
RUN chmod -R a+rX /app /opt/peopleportal-sdk && pip install --no-cache-dir -c requirements.lock '.[llm,pipeline]' && pip install --no-cache-dir /opt/peopleportal-sdk && useradd --create-home --uid 10001 horizon && mkdir -p /var/lib/horizon /app/data && chown -R horizon:horizon /var/lib/horizon /app/data
USER horizon
EXPOSE 8000
CMD ["sh", "-c", "exec python -m uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
