{
  "name": "pplsdk-ts",
  "projectType": "library",
  "sourceRoot": "peopleportal/sdk/ts/src",
  "targets": {
    "install-deps": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm install",
        "cwd": "{projectRoot}"
      },
      "outputs": [
        "{projectRoot}/node_modules"
      ]
    },
    "generate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "install-deps",
        "pplserver:build"
      ],
      "options": {
        "command": "docker run --rm -v \"$PWD:/local\" openapitools/openapi-generator-cli generate -i /local/peopleportal/server/dist/swagger.json -g typescript-axios -o /local/peopleportal/sdk/ts/src",
        "cwd": "{workspaceRoot}"
      },
      "outputs": [
        "{projectRoot}/src"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "generate"
      ],
      "options": {
        "command": "tsc",
        "cwd": "{projectRoot}"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  }
}
