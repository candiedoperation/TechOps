# Authentik
PEOPLEPORTAL_AUTHENTIK_TOKEN=your-authentik-api-token
PEOPLEPORTAL_AUTHENTIK_ENDPOINT=https://localhost:9443

# OpenID Connect (from your Authentik OAuth2/OIDC provider application)
PEOPLEPORTAL_OIDC_DSCVURL=https://localhost:9443/application/o/people-portal/.well-known/openid-configuration
PEOPLEPORTAL_OIDC_CLIENTID=your-oidc-client-id
PEOPLEPORTAL_OIDC_CLIENTSECRET=your-oidc-client-secret

# Server
PEOPLEPORTAL_BASE_URL=http://localhost:3000
PEOPLEPORTAL_MONGO_URL=mongodb://localhost:27017/people-portal
PEOPLEPORTAL_REDIS_URL=redis://localhost:6379

# Gitea
PEOPLEPORTAL_GITEA_ENDPOINT=http://localhost:10000
PEOPLEPORTAL_GITEA_TOKEN=your-gitea-api-token
# Generate a random value of at least 32 characters; Gitea sends it as Authorization: Bearer <secret>
PEOPLEPORTAL_GITEA_WEBHOOK_SECRET=replace-with-a-random-32-character-or-longer-secret

# Disable TLS verification for local self-signed certs (do not use in prod)
NODE_TLS_REJECT_UNAUTHORIZED=0

# AWS (placeholders are fine unless you're working on AWS provisioning features)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

AWS_ORG_ROOT_ID=your-org-root-id
AWS_NONPROD_OU_ID=your-nonprod-ou-id
AWS_MANAGEMENT_ACCOUNT_ID=your-management-account-id
AWS_ADMIN_ROLE_NAME=OrganizationAccountAccessRole

AWS_DEFAULT_BUDGET_AMOUNT=20
AWS_BILLING_ALERT_EMAIL=you@example.com

S3_BUCKET_NAME=your-s3-bucket-name

# SMTP (email notifications)
PEOPLEPORTAL_SMTP_HOST=smtp.gmail.com
PEOPLEPORTAL_SMTP_PORT=465
PEOPLEPORTAL_SMTP_SECURE=true
PEOPLEPORTAL_SMTP_DEFAULTFROM=your-smtp-email@gmail.com # Added to support CloudFlare
PEOPLEPORTAL_SMTP_USER=smtp_username
PEOPLEPORTAL_SMTP_PASS=your-smtp-app-password

# Slack
PEOPLEPORTAL_SLACK_BOT_TOKEN=<your-slack-bot-token>
PEOPLEPORTAL_SLACK_INVITE_URL=https://slack.com

# Webhooks
PEOPLEPORTAL_WEBHOOK_URL=http://localhost:3000
# Face check service (profile photo validation)
# Profile-photo face check. Off by default: the sidecar that serves
# PHOTO_CHECK_URL ships with PeoplePortalDeploy PR #1. Turn this on only once
# that container is actually running, or every upload is waved through.
PHOTO_CHECK_ENABLED=false
PHOTO_CHECK_URL=http://localhost:8001
