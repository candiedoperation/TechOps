# scripts/gen-env.sh creates .env automatically and fills empty secrets once.
# Initial overrides can be exported before scripts/up.sh; later edit .env.
# Use simple KEY=value or KEY='value' lines, with no inline comments/expansion.
COMPOSE_PROJECT_NAME=ppdev
PUBLIC_HOST=localhost
BIND_ADDRESS=127.0.0.1
AUTHENTIK_PORT=9000
GITEA_PORT=3001
GITEA_SSH_PORT=2222
MONGO_PORT=27017
REDIS_PORT=6379
MAILPIT_PORT=8025
SMTP_PORT=1025
PORTAL_PORT=3000
WEBUI_PORT=5173
# Derived from PUBLIC_HOST and ports when empty. No trailing slash.
PORTAL_BASE_URL=
AUTHENTIK_URL=
GITEA_URL=
S3_ENDPOINT=http://s3.example.invalid
S3_CORS_ORIGINS=

# Local credentials only. Never reuse staging or production credentials.
POSTGRES_PASSWORD=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@example.invalid
PORTAL_OIDC_CLIENT_ID=people-portal-dev
PORTAL_OIDC_CLIENT_SECRET=
PORTAL_TOKEN_SECRET=
GITEA_OIDC_CLIENT_ID=gitea-dev
GITEA_OIDC_CLIENT_SECRET=
GITEA_ADMIN_USER=devadmin
GITEA_ADMIN_PASSWORD=
GITEA_ADMIN_EMAIL=devadmin@example.invalid
GITEA_WEBHOOK_SECRET=
S3_ACCESS_KEY=local-placeholder
S3_SECRET_KEY=local-placeholder
# Reserved placeholders. No S3 service is included.
S3_BUCKET_NAME=people-portal
AWS_REGION=us-east-1
