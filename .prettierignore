# Handlebars email templates use partials ({{> header}}), which Prettier's
# glimmer parser cannot handle ("Handlebars partials are not supported").
# The partials themselves (header.hbs, footer.hbs) parse fine, so keep them checked.
peopleportal/server/src/clients/EmailClient/templates/*.hbs
!peopleportal/server/src/clients/EmailClient/templates/header.hbs
!peopleportal/server/src/clients/EmailClient/templates/footer.hbs

